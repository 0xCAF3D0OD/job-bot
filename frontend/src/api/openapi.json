              }
            }
          }
        }
      }
    },
    "/api/offers": {
      "get": {
        "tags": [
          "collect"
        ],
        "summary": "List Offers",
        "operationId": "listOffers",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
