# Réglages de la démo en ligne (docs/77). Copier en `.env`, puis adapter l'adresse.

# L'adresse de la démo, sans https:// ; elle doit déjà pointer vers ce serveur (enregistrement A).
DEMO_DOMAIN=demo.joba1.ch
# La même, avec https:// : utilisée dans les liens de l'application.
DEMO_PUBLIC_URL=https://demo.joba1.ch

# Mot de passe de la base, qui n'est joignable que depuis l'API (aucun port publié).
# Change-le si tu veux ; il ne protège que des données fictives.
DEMO_DB_PASSWORD=demo
