# Réglages de la vraie plateforme jobA1 sur le serveur (docs/136). Copié en `jobbot.env` par
# l'installation ; à remplir avec `make prod-reglages` depuis le Mac. Jamais dans git.
# Les adresses de la base, l'adresse publique, les dossiers et le mode prod sont posés par
# docker-compose.yml : ne les mets pas ici. Référence complète : docs/exploitation.md.

# --- IA ---
JOBBOT_ANTHROPIC_API_KEY=
JOBBOT_LLM_MODEL=claude-opus-5
JOBBOT_LLM_SCORE_MODEL=
JOBBOT_LLM_EFFORT=low

# --- Les alertes de l'exploitant (Gmail, mot de passe d'application) ---
JOBBOT_IMAP_USER=
JOBBOT_IMAP_PASSWORD=
JOBBOT_IMAP_FOLDER=INBOX
JOBBOT_MAIL_ADDRESS=

# --- Les alertes des invités (docs/113) ---
JOBBOT_ALERT_DOMAIN=
JOBBOT_GUEST_IMAP_USER=
JOBBOT_GUEST_IMAP_PASSWORD=

# --- Notifications (sujet ntfy difficile à deviner) ---
JOBBOT_NTFY_TOPIC=

# --- Sauvegardes (docs/82) : sans phrase, aucune sauvegarde. Garde-la aussi ailleurs. ---
JOBBOT_BACKUP_PASSPHRASE=

# --- « Voir la démo » sur « La plateforme » ---
JOBBOT_DEMO_URL=https://demo.joba1.ch

# --- Le paiement de Plus (docs/125) : fermé tant que ce n'est pas validé ---
JOBBOT_BILLING_ENABLED=false
JOBBOT_PAYREXX_INSTANCE=
JOBBOT_PAYREXX_API_SECRET=
JOBBOT_PAYREXX_WEBHOOK_KEY=
