{
  "manifest_version": 3,
  "name": "job-bot — remplir mes candidatures",
  "short_name": "job-bot",
  "version": "0.18.0",
  "description": "Remplit le formulaire de candidature de l'employeur avec tes données job-bot. N'envoie jamais rien à ta place.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Remplir avec job-bot",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
