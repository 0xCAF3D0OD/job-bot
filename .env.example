# Configuration de job-bot : uniquement des variables d'environnement.
# [secret] : à mettre dans un Secret ; accepte aussi la variante <NOM>_FILE (chemin d'un fichier).
# [config] : à mettre dans une ConfigMap.
# Référence complète : docs/exploitation.md

# [secret] URL PostgreSQL, pilote psycopg obligatoire. Depuis 0.64 (docs/78) : trois accès.
# L'API avec le rôle restreint jobbot_app, le worker avec jobbot_worker, les migrations avec le
# propriétaire des tables. Vides : l'adresse de l'API pour tout, comme avant (déconseillé si
# c'est un administrateur : « La plateforme » le signale). Voir docs/exploitation.md.
JOBBOT_DATABASE_URL=postgresql+psycopg://jobbot_app@localhost:5432/jobbot
JOBBOT_WORKER_DATABASE_URL=postgresql+psycopg://jobbot_worker@localhost:5432/jobbot
JOBBOT_MIGRATE_DATABASE_URL=postgresql+psycopg://localhost:5432/jobbot

# [config] dev | prod (prod : logs JSON, documentation de l'API masquée)
JOBBOT_ENV=dev

# [config] 0.0.0.0 dans un conteneur
JOBBOT_API_HOST=127.0.0.1
JOBBOT_API_PORT=8000

# [config] santé et métriques du worker
JOBBOT_WORKER_HTTP_PORT=8001

# [config] DEBUG | INFO | WARNING | ERROR
JOBBOT_LOG_LEVEL=INFO
# [config] console | json (par défaut : console en dev, json en prod)
# JOBBOT_LOG_FORMAT=

# [config] false : le worker n'exécute plus les tâches planifiées (à déclencher par `jobbot run-job`)
JOBBOT_SCHEDULER_ENABLED=true

# [config] seul dossier où l'application écrit (documents, exports) : le volume à monter
# En local, relatif à backend/ (dossier depuis lequel le Makefile lance les commandes).
JOBBOT_STORAGE_BACKEND=local
JOBBOT_STORAGE_PATH=../data

# Sauvegardes (docs/82) : chaque nuit, chiffrées, gardées 7 jours, 4 semaines et 6 mois.
# [config] Le dossier : de préférence un dossier synchronisé hors de l'ordinateur (iCloud Drive…).
JOBBOT_BACKUP_PATH=../sauvegardes
# [secret] La phrase qui chiffre les sauvegardes. Sans elle, aucune sauvegarde ; perdue, les
# sauvegardes sont illisibles : garde-la aussi ailleurs (gestionnaire de mots de passe, papier).
JOBBOT_BACKUP_PASSPHRASE=

# [config] liste JSON, seulement si le frontend est servi sur une autre origine que l'API
# JOBBOT_CORS_ORIGINS=["https://jobbot.example"]

# [config] renvoyée par /version : tag ou SHA git, à remplir au build
JOBBOT_VERSION=dev

# --- Collecte des alertes (0.2) ---
# Adresse Gmail dédiée aux alertes ; collecte inactive tant que USER ou PASSWORD est vide.
# [config]
JOBBOT_IMAP_USER=
# [secret] mot de passe d'application Google (pas le mot de passe du compte)
JOBBOT_IMAP_PASSWORD=
# [config]
JOBBOT_IMAP_HOST=imap.gmail.com
JOBBOT_IMAP_PORT=993
JOBBOT_IMAP_FOLDER=INBOX
# [config] profondeur du premier passage, en jours
JOBBOT_IMAP_BACKFILL_DAYS=30
# Adresse où arrivent les alertes (vide : JOBBOT_IMAP_USER). Un compte invité reçoit à
# « boite+code@domaine », livré dans la même boîte (docs/65 §3).
JOBBOT_MAIL_ADDRESS=

# --- IA (0.4) ---
# [secret] clé de l'API Anthropic (console.anthropic.com), facturée à l'usage ; vide : pas de note
JOBBOT_ANTHROPIC_API_KEY=
# [config]
JOBBOT_LLM_MODEL=claude-opus-5
# La notation des offres avec un modèle moins cher (docs/125) ; vide : le modèle principal.
# Comparer d'abord : uv run jobbot score-compare --model claude-sonnet-5
JOBBOT_LLM_SCORE_MODEL=
JOBBOT_LLM_EFFORT=low

# --- Notifications (0.4) ---
# [secret] sujet ntfy, difficile à deviner (quiconque le connaît lit tes notifications) ; vide : aucune
JOBBOT_NTFY_TOPIC=
# [config]
JOBBOT_NTFY_URL=https://ntfy.sh
# [config] adresse de l'interface, pour le lien des notifications
JOBBOT_PUBLIC_URL=http://localhost:5173
# [config] connexion obligatoire hors Actualités (docs/18) ; false seulement pour un essai local.
# Le compte se crée avec : cd backend && uv run jobbot set-password
JOBBOT_AUTH_ENABLED=true
